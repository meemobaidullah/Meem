# Copy to .env (NEVER commit .env or upload it into public_html). Put real values on the server only.
APP_ENV=production
APP_URL=https://meemobaidullah.com
APP_DEBUG=false
# DB_DRIVER: mysql (Hostinger) or sqlite (local testing)
DB_DRIVER=mysql
DB_HOST=localhost
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASS=
# sqlite only:
DB_SQLITE_PATH=storage/data/app.sqlite
# Used to hash IP addresses and sign form tokens. REQUIRED, at least 32 characters.
# Generate with: php -r "echo bin2hex(random_bytes(32));"
APP_KEY=
# Email (SMTP) - used only when configured; leave empty to disable email notices
MAIL_HOST=
MAIL_PORT=587
MAIL_USER=
MAIL_PASS=
MAIL_FROM=
MAIL_NOTIFY_TO=
